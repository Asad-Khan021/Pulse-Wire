# Pulse Wire Local Backend Environment Configuration
ENVIRONMENT=development
APP_NAME=Pulse Wire API
APP_VERSION=1.0.0
DEBUG=True

# SQLite async database for seamless local development without PostgreSQL setup
DATABASE_URL=sqlite+aiosqlite:///./pulse_wire.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=False

# Cache Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_ENABLED=False

# Authentication
SUPABASE_URL=https://pulse-wire.supabase.co
SUPABASE_JWT_SECRET=super-secret-pulse-wire-jwt-key-min-32-chars-for-dev
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated

# NewsAPI Configuration
NEWS_API_KEY=5a0882eac8064e06a7376d73e3d2fa73
NEWS_API_ENABLED=True

# CORS - Allow all origins in development
ALLOWED_ORIGINS=["*"]
