# ==============================================================================
# Environment Configuration Template for Digest Backend
# DO NOT COMMIT REAL CREDENTIALS TO SOURCE CONTROL
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
APP_NAME=Digest API
APP_VERSION=1.0.0
DEBUG=True

# Database Configuration (PostgreSQL with asyncpg driver)
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/digest_db
# Supabase: postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/digest_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=False

# Upstash Redis / Local Redis Cache (TLS supported via rediss://)
# Local: redis://localhost:6379/0
# Upstash: rediss://default:[token]@[endpoint]:6379
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_ENABLED=True

# Supabase Auth Configuration
# Obtain SUPABASE_JWT_SECRET from Supabase Dashboard -> Project Settings -> API -> JWT Secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=super-secret-jwt-key-replace-in-production
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated

# Google Gemini API Key (Server-Side Only - Never expose to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Security & CORS (allowed client origins, comma-separated in env)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","https://digest-app.web.app"]
